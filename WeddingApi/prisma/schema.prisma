model Guest {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String?
  lastName  String?
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsvp RSVP? @relation("GuestRSVP")
}

model RSVP {
  id        Int      @id @default(autoincrement())
  name      String
  attending Boolean
  guests    Int      @default(0)
  message   String?
  createdAt DateTime @default(now())

  // relation back to Guest (nullable so existing RSVPs don’t break)
  guestId Int?   @unique
  guest   Guest? @relation("GuestRSVP", fields: [guestId], references: [id])
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}
